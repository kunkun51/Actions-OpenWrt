patible = \"mmc-card\";","\t\treg = \x3C0>;","","\t\tblock {","\t\t\tcompatible = \"block-device\";","","\t\t\tpartitions {","\t\t\t\tblock-partition-factory {","\t\t\t\t\tpartname = \"factory\";","","\t\t\t\t\tnvmem-layout {","\t\t\t\t\t\tcompatible = \"fixed-layout\";","\t\t\t\t\t\t#address-cells = \x3C1>;","\t\t\t\t\t\t#size-cells = \x3C1>;","","\t\t\t\t\t\teeprom_factory_0: eeprom@0 {","\t\t\t\t\t\t\treg = \x3C0x0 0x1000>;","\t\t\t\t\t\t};","","\t\t\t\t\t\tmacaddr_factory_4: macaddr@4 {","\t\t\t\t\t\t\tcompatible = \"mac-base\";","\t\t\t\t\t\t\treg = \x3C0x4 0x6>;","\t\t\t\t\t\t\t#nvmem-cell-cells = \x3C1>;","\t\t\t\t\t\t};","\t\t\t\t\t};","\t\t\t\t};","\t\t\t};","\t\t};","\t};","};","","&pio {","\tmmc0_pins_default: mmc0-pins-default {","\t\tmux {","\t\t\tfunction = \"flash\";","\t\t\tgroups = \"emmc_45\";","\t\t};","\t};","","\tmmc0_pins_uhs: mmc0-pins-uhs {","\t\tmux {","\t\t\tfunction = \"flash\";","\t\t\tgroups = \"emmc_45\";","\t\t};","\t};","};"],stylingDirectives:$R[795]=[$R[796]=[],$R[797]=[],$R[798]=[],$R[799]=[],$R[800]=[],$R[801]=[],$R[802]=[],$R[803]=[],$R[804]=[],$R[805]=[],$R[806]=[],$R[807]=[],$R[808]=[],$R[809]=[],$R[810]=[],$R[811]=[],$R[812]=[],$R[813]=[],$R[814]=[],$R[815]=[],$R[816]=[],$R[817]=[],$R[818]=[],$R[819]=[],$R[820]=[],$R[821]=[],$R[822]=[],$R[823]=[],$R[824]=[],$R[825]=[],$R[826]=[],$R[827]=[],$R[828]=[],$R[829]=[],$R[830]=[],$R[831]=[],$R[832]=[],$R[833]=[],$R[834]=[],$R[835]=[],$R[836]=[],$R[837]=[],$R[838]=[],$R[839]=[],$R[840]=[],$R[841]=[],$R[842]=[],$R[843]=[],$R[844]=[],$R[845]=[],$R[846]=[],$R[847]=[],$R[848]=[],$R[849]=[],$R[850]=[],$R[851]=[],$R[852]=[],$R[853]=[],$R[854]=[],$R[855]=[],$R[856]=[],$R[857]=[],$R[858]=[],$R[859]=[],$R[860]=[],$R[861]=[],$R[862]=[],$R[863]=[],$R[864]=[],$R[865]=[],$R[866]=[],$R[867]=[],$R[868]=[],$R[869]=[],$R[870]=[]],colorizedLines:null}}},dataUpdateCount:1,dataUpdatedAt:1792482166596,error:null,errorUpdateCount:0,errorUpdatedAt:0,fetchFailureCount:0,fetchFailureReason:null,fetchMeta:null,isInvalidated:!1,status:"success",fetchStatus:"idle"},queryKey:$R[258],queryHash:"[\"code-view\",\"codeViewBlobLayoutRoute\",\"\",\"codeViewBlobLayoutRoute.StyledBlob\",{\"pathname\":\"/openwrt/openwrt/_styled/main/target/linux/mediatek/dts/mt7981b-huasifei-wh3000-pro-emmc.dts\"}]"},$R[871]={dehydratedAt:1792482166667,state:$R[872]={data:$R[873]={showLicenseMeta:!1,license:null,newIssuePath:"/openwrt/openwrt/issues/new",newDiscussionPath:null,codeownerInfo:$R[874]={codeownerPath:null,ownedByCurrentUser:null,ownersForFile:null,ruleForPathLine:null}},dataUpdateCount:1,dataUpdatedAt:1792482166596,error:null,errorUpdateCount:0,errorUpdatedAt:0,fetchFailureCount:0,fetchFailureReason:null,fetchMeta:null,isInvalidated:!1,status:"success",fetchStatus:"idle"},queryKey:$R[261],queryHash:"[\"code-view\",\"codeViewBlobLayoutRoute\",\"\",\"deferredMetadata\",{\"pathname\":\"/openwrt/openwrt/deferred-metadata/main/target/linux/mediatek/dts/mt7981b-huasifei-wh3000-pro-emmc.dts\"}]"},$R[875]={dehydratedAt:1792482166667,state:$R[876]={data:$R[877]={oid:"f4c211f635283f085c88be40e8cddc89f8d79e5e",url:"/openwrt/openwrt/commit/f4c211f635283f085c88be40e8cddc89f8d79e5e",date:"2026-04-06T22:39:41.000+02:00",shortMessageHtmlLink:"\x3Ca data-pjax=\"true\" data-hovercard-url=\"/openwrt/openwrt/commit/f4c211f635283f085c88be40e8cddc89f8d79e5e/hovercard\" data-hovercard-type=\"commit\" class=\"Link--secondary\" href=\"/openwrt/openwrt/commit/f4c211f635283f085c88be40e8cddc89f8d79e5e\">mediatek: add Huasifei WH3000 Pro NAND support\x3C/a>",bodyMessageHtml:"This commit adds support for Huasifei WH3000 Pro NAND version.\nThere is an eMMC already supported in OpenWrt. The only difference is NAND chip.\nThis commit adds common .dtsi and separate .dts\nfor eMMC and nand versions.\n\n**Huasifei WH3000 Pro NAND**\nPortable Wi-Fi 6 travel router based on MediaTek MT7981A SoC. MT7981B+MT7976CN+RTL8221B Dual Core 1.3GHZ with 5G modems module and PWM Fan.\n\n**Specifications**\nSoC: Filogic 820 MT7981A (1.3GHz)\nRAM: DDR4 1GB\nFlash: 256mb Winbond SPI NAND\nWiFi: 2.4GHz and 5GHz with 3 antennas\nEthernet:\n1x WAN (10/100/1000M)\n1x LAN (10/100/1000/2500M)\nUSB: 1x USB 3.0 port\nTwo buttons: reset and mode (BTN_0)\nLEDS: blue, red, blue+red=pink\nUART: 3.3V, TX, RX, GND / 115200 8N1\nM.2 (WWAN) slot\n\n**Installation via U-Boot rescue**\n1. Set static IP 192.168.1.2 on your computer and default route as 192.168.1.1\n2. Connect to the WAN port and hold the reset button while booting the device.\n3. Wait for the LED to blink 5 times, and release the reset button.\n4. Open U-boot web page on your browser at \x3Ca href=\"http://192.168.1.1\" rel=\"nofollow\">http://192.168.1.1\x3C/a>\n5. Select the OpenWRT sysupgrade image, upload it, and start the upgrade.\n6. Wait for the router to flash the new firmware.\n7. Wait for the router to reboot itself.\n\n**Installation via sysupgrade**\nJust flash sysupgrade file via [LuCI upgrade page](\x3Ca href=\"http://192.168.1.1/cgi-bin/luci/admin/system/flash\" rel=\"nofollow\">http://192.168.1.1/cgi-bin/luci/admin/system/flash\x3C/a>) without saving the settings.\n\n**Installation via SSH**\nUpload the file to the router `/tmp` directory, `ssh root@192.168.1.1` and issue a command:\n```\nsysupgrade -n /tmp/openwrt-mediatek-filogic-huasifei_wh3000-pro-nand-squashfs-sysupgrade.bin\n```\n\nSigned-off-by: Fil Dunsky &lt;filipp.dunsky@gmail.com&gt;\nLink: \x3Ca class=\"issue-link js-issue-link\" data-error-text=\"Failed to load title\" data-id=\"4171061107\" data-permission-text=\"Title is private\" data-url=\"https://github.com/openwrt/openwrt/issues/22694\" data-hovercard-type=\"pull_request\" data-hovercard-url=\"/openwrt/openwrt/pull/22694/hovercard\" href=\"https://github.com/openwrt/openwrt/pull/22694\">#22694\x3C/a>\nSigned-off-by: Hauke Mehrtens &lt;hauke@hauke-m.de&gt;",author:$R[878]={displayName:"Fil Dunsky",login:"fildunsky",path:"/fildunsky",avatarUrl:"https://avatars.githubusercontent.com/u/32987666?s=40&v=4"},authors:$R[879]=[$R[880]={login:"fildunsky",displayName:"Fil Dunsky",avatarUrl:"https://avatars.githubusercontent.com/u/32987666?v=4",path:"/fildunsky",profileName:"Fil Dunsky",isGitHub:!1}],committerAttribution:!0,committer:$R[881]={login:"hauke",displayName:"Hauke Mehrtens",avatarUrl:"https://avatars.githubusercontent.com/u/78494?v=4",path:"/hauke",profileName:"Hauke Mehrtens",isGitHub:!1},showPusherAttribution:!1,pusher:null,pushedDate:null,status:"success",statusChecksAliveChannel:"eyJjIjoicmVwbzo0NTgyMTU0MDpjb21taXQ6ZjRjMjExZjYzNTI4M2YwODVjODhiZTQwZThjZGRjODlmOGQ3OWU1ZSIsInQiOjE3OTI0ODIxNjZ9--00092d17ceece5568e5b8195b5c6aed593ccc0e54dd000258e15a247bc9e9cba",isSpoofed:!1},dataUpdateCount:1,dataUpdatedAt:1792482166618,error:null,errorUpdateCount:0,errorUpdatedAt:0,fetchFailureCount:0,fetchFailureReason:null,fetchMeta:null,isInvalidated:!1,status:"success",fetchStatus:"idle"},queryKey:$R[264],queryHash:"[\"code-view\",\"codeViewBlobLayoutRoute\",\"\",\"latestCommit\",{\"pathname\":\"/openwrt/openwrt/latest-commit/main/target/linux/mediatek/dts/mt7981b-huasifei-wh3000-pro-emmc.dts\"}]"},$R[882]={dehydratedAt:1792482166667,state:$R[883]={data:$R[884]={meta:$R[885]={title:"openwrt/target/linux/mediatek/dts/mt7981b-huasifei-wh3000-pro-emmc.dts at main · openwrt/openwrt"},payload:$R[886]={csv:null,csvError:null,headerInfo:$R[887]={toc:null},issueTemplate:null,discussionTemplate:null,richText:null,richTextTruncated:!1,renderedFileInfo:null,symbols:$R[888]={timed_out:!1,not_analyzed:!0,symbols:$R[889]=[]}}},dataUpdateCount:1,dataUpdatedAt:1792482166640,error:null,errorUpdateCount:0,errorUpdatedAt:0,fetchFailureCount:0,fetchFailureReason:null,fetchMeta:null,isInvalidated:!1,status:"success",fetchStatus:"idle"},queryKey:$R[271],queryHash:"[\"code-view\",\"codeViewBlobRoute\",\"/:owner/:repo/blob/:branch/*\",\"mainQuery\",{\"pathname\":\"/openwrt/openwrt/blob/main/target/linux/mediatek/dts/mt7981b-huasifei-wh3000-pro-emmc.dts\",\"searchParams\":{}}]"}]}}})($R["tsr"]);document.currentScript.remove()</script><script type="module" async="" src="https://github.githubassets.com/assets/index-BFhbldsr.js" crossorigin="anonymous" nonce="Yb2YV9C8XtIO2ZjbFqycZB5fePb7zODO"></script><script nonce='Yb2YV9C8XtIO2ZjbFqycZB5fePb7zODO'>($R=>$R[281].return(void 0))($R["tsr"]);$_TSR.e();document.currentScript.remove()</script></body></html>